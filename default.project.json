{
  "name": "BraveKidSchoolStory",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 40,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Brightness": 2.4,
        "Ambient": [0.42, 0.45, 0.5],
        "OutdoorAmbient": [0.5, 0.52, 0.55],
        "ClockTime": 13.5,
        "GeographicLatitude": 35,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.4
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FallenPartsDestroyHeight": -200
      },
      "SafeGround": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [520, 4, 400],
          "CFrame": [0, 0, -10, 1, 0, 0, 0, 1, 0, 0, 0, 1],
          "Color": [0.36, 0.66, 0.38],
          "Material": "Grass"
        }
      },
      "SafeSpawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Duration": 0,
          "Neutral": true,
          "Size": [16, 1, 16],
          "CFrame": [0, 3.5, 58, 1, 0, 0, 0, 1, 0, 0, 0, 1],
          "Color": [0.36, 0.66, 0.86],
          "Material": "SmoothPlastic"
        }
      }
    }
  }
}
