{
  "name": "GolfSwingGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "GolfShared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "HitBall": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "GolfServer": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "GolfClient": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 120
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [70, 80, 70],
        "Brightness": 2,
        "ClockTime": 14
      }
    }
  }
}
