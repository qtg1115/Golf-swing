      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local FOLDER_NAME = "SchoolRemotes"
local REMOTE_NAMES = {
	"GetProfile",
	"ProfileUpdated",
	"PeriodChanged",
	"Notify",
	"StoryUpdated",
	"Dialogue",
	"BuyItem",
	"UseItem",
	"ClaimQuest",
	"EncounterStart",
	"EncounterEnd",
	"EncounterAction",
	"BullyWarning",
}

local function getFolder(): Folder
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if folder and folder:IsA("Folder") then
		return folder
	end

	folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	return folder
end

function Remotes.ensure(): Folder
	local folder = getFolder()
	for _, name in REMOTE_NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	return folder
end

function Remotes.get(name: string): RemoteEvent
	local folder = Remotes.ensure()
	local remote = folder:WaitForChild(name, 10)
	assert(remote and remote:IsA("RemoteEvent"), "Missing remote: " .. name)
	return remote
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[local Util = {}

function Util.clamp(value: number, minValue: number, maxValue: number): number
	return math.clamp(value, minValue, maxValue)
end

function Util.round(value: number, digits: number): number
	local factor = 10 ^ digits
	return math.floor(value * factor + 0.5) / factor
end

function Util.average(values: { [string]: number }): number
	local total = 0
	local count = 0
	for _, value in values do
		total += value
		count += 1
	end
	if count == 0 then
		return 0
	end
	return total / count
end

function Util.deepCopy(value)
	if typeof(value) ~= "table" then
		return value
	end

	local copy = {}
	for key, child in value do
		copy[key] = Util.deepCopy(child)
	end
	return copy
end

function Util.xpForLevel(level: number): number
	return 70 + (level - 1) * 40
end

function Util.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local minutes = math.floor(seconds / 60)
	local remain = seconds % 60
	return string.format("%d:%02d", minutes, remain)
end

function Util.titleForLevel(level: number, titles): string
	local current = "신입생"
	for _, entry in titles do
		if level >= entry.min then
			current = entry.title
		end
	end
	return current
end

function Util.confrontPower(profile, config): number
	local power = profile.level
	if profile.owned.courage_badge then
		power += config.Items.courage_badge.power or 3
	end
	power += (profile.stats.friendsHelped or 0)
	return power
end

return Util
]]></string>
        </Properties>
      </Item>
