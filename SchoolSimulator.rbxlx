      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ActorFactory</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")

local ActorFactory = {}

-- Actors are anchored block characters moved with PivotTo.
-- No Humanoid is used, so they never ragdoll, fall, or need pathfinding.
local function block(parent: Instance, name: string, size: Vector3, offset: Vector3, color: Color3): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.Size = size
	p.CFrame = CFrame.new(offset)
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function ActorFactory.create(info): Model
	local model = Instance.new("Model")
	model.Name = info.name

	local skin = Color3.fromRGB(236, 202, 168)
	local pants = Color3.fromRGB(48, 54, 76)

	local root = block(model, "Root", Vector3.new(2, 5, 1), Vector3.new(0, 0, 0), info.color)
	root.Transparency = 1
	model.PrimaryPart = root

	block(model, "Torso", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), info.color)
	local head = block(model, "Head", Vector3.new(1.5, 1.5, 1.5), Vector3.new(0, 1.8, 0), skin)
	block(model, "ArmLeft", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0), info.color)
	block(model, "ArmRight", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0), info.color)
	block(model, "LegLeft", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0), pants)
	block(model, "LegRight", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0), pants)

	local eyeL = block(model, "EyeL", Vector3.new(0.25, 0.25, 0.1), Vector3.new(-0.35, 2, -0.75), Color3.fromRGB(30, 30, 40))
	local eyeR = block(model, "EyeR", Vector3.new(0.25, 0.25, 0.1), Vector3.new(0.35, 2, -0.75), Color3.fromRGB(30, 30, 40))
	eyeL.Material = Enum.Material.SmoothPlastic
	eyeR.Material = Enum.Material.SmoothPlastic

	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(190, 46)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.Parent = head

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = info.name .. "\n" .. (info.role or "")
	label.TextColor3 = info.labelColor or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui

	model:PivotTo(CFrame.new(info.position))

	if info.action then
		CollectionService:AddTag(root, "Interact")
		root:SetAttribute("Action", info.action)
		root:SetAttribute("Npc", info.name)

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = info.prompt or "Talk"
		prompt.ObjectText = info.name
		prompt.HoldDuration = 0.1
		prompt.MaxActivationDistance = 13
		prompt.RequiresLineOfSight = false
		prompt.Parent = root
	end

	model.Parent = info.parent or workspace
	return model
end

function ActorFactory.moveTowards(model: Model, target: Vector3, speed: number, dt: number)
	local pivot = model:GetPivot()
	local from = pivot.Position
	local flatTarget = Vector3.new(target.X, from.Y, target.Z)
	local delta = flatTarget - from
	local distance = delta.Magnitude
	if distance < 0.5 then
		return
	end
	local direction = delta.Unit
	local step = math.min(speed * dt, distance - 0.25)
	if step <= 0 then
		return
	end
	local nextPos = from + direction * step
	model:PivotTo(CFrame.lookAt(nextPos, nextPos + direction))
end

return ActorFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">BullyService</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local ActorFactory = require(script.Parent.ActorFactory)
local DataService = require(script.Parent.DataService)
local Progress = require(script.Parent.Progress)
local StoryService = require(script.Parent.StoryService)

local BullyService = {}

local NURSE = CFrame.new(-50, 7, 60)
local CHASE_TIME = 8

local models: { [string]: Model } = {}
local calmUntil: { [string]: number } = {}
local wanderTarget: { [string]: Vector3 } = {}
local encounters: { [number]: any } = {}

local function playerRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function nearHideSpot(player: Player): boolean
	local root = playerRoot(player)
	if not root then
		return false
	end
	for _, spot in CollectionService:GetTagged("HideSpot") do
		if spot:IsA("BasePart") and (spot.Position - root.Position).Magnitude <= 12 then
			return true
		end
	end
	return false
end

local function sendToNurse(player: Player)
	local root = playerRoot(player)
	if root then
		root.CFrame = NURSE
	end
end

local function closeEncounter(player: Player)
	encounters[player.UserId] = nil
	Remotes.get("EncounterEnd"):FireClient(player)
end

local function win(player: Player, profile, bully, message: string, statName: string, xp: number)
	Progress.stat(profile, statName)
	Progress.addXp(player, profile, xp)
	Progress.notify(player, message, "good")
	StoryService.onBully(player, bully.id)
	calmUntil[bully.id] = os.clock() + 20
	closeEncounter(player)
	Progress.push(player)
end

local function lose(player: Player, profile, message: string)
	profile.courage = Util.clamp(profile.courage - 20, 0, profile.maxCourage)
	Progress.notify(player, message, "warn")
	sendToNurse(player)
	profile.courage = Util.clamp(profile.courage + 25, 0, profile.maxCourage)
	closeEncounter(player)
	Progress.push(player)
end

function BullyService.act(player: Player, action: string, itemId: string?)
	local encounter = encounters[player.UserId]
	local profile = DataService.get(player)
	if not encounter or not profile then
		return
	end
	local bully = encounter.bully

	if action == "item" and itemId then
		local item = Config.Items[itemId]
		local count = profile.bag[itemId] or 0
		if not item or count < 1 then
			Progress.notify(player, "You do not have that item.", "warn")
			return
		end
		profile.bag[itemId] = count - 1
		if item.escape then
			win(player, profile, bully, "You used the note and slipped away safely!", "escapes", 20)
			return
		end
		if item.power then
			encounter.bonus = (encounter.bonus or 0) + item.power
			Progress.notify(player, "You blew the whistle! Stand-up power went up.", "info")
			Remotes.get("EncounterStart"):FireClient(player, {
				name = bully.name,
				role = bully.role,
				power = bully.power,
				myPower = Util.standUpPower(profile) + encounter.bonus,
			})
			Progress.push(player)
			return
		end
		profile.energy = Util.clamp(profile.energy + (item.energy or 0), 0, profile.maxEnergy)
		profile.courage = Util.clamp(profile.courage + (item.courage or 0), 0, profile.maxCourage)
		Progress.notify(player, "You used " .. item.name .. ".", "info")
		Progress.push(player)
		return
	end

	if action == "hide" then
		if nearHideSpot(player) then
			win(player, profile, bully, "You hid and the bully walked right past you!", "escapes", 22)
		else
			Progress.notify(player, "No hiding spot nearby. Look for green bushes or lockers.", "warn")
		end
		return
	end

	if action == "run" then
		if encounter.running then
			return
		end
		encounter.running = true
		encounter.runUntil = os.clock() + CHASE_TIME
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = Config.WalkSpeed + 14
		end
		Progress.notify(player, "Run! Get far away before the bully catches up.", "info")
		return
	end

	if action == "stand" then
		local myPower = Util.standUpPower(profile) + (encounter.bonus or 0)
		if myPower >= bully.power then
			profile.coins += bully.coins
			profile.courage = Util.clamp(profile.courage + 10, 0, profile.maxCourage)
			win(
				player,
				profile,
				bully,
				string.format("You stood up to %s and won! (%d vs %d)", bully.name, myPower, bully.power),
				"standups",
				bully.xp
			)
		else
			lose(
				player,
				profile,
				string.format("Not strong enough yet (%d vs %d). Go to class and get gear.", myPower, bully.power)
			)
		end
	end
end

local function startEncounter(player: Player, bully)
	local profile = DataService.get(player)
	if not profile or encounters[player.UserId] then
		return
	end
	encounters[player.UserId] = { bully = bully, bonus = 0 }
	Remotes.get("EncounterStart"):FireClient(player, {
		name = bully.name,
		role = bully.role,
		power = bully.power,
		myPower = Util.standUpPower(profile),
		boss = bully.boss == true,
	})
	Progress.notify(player, bully.name .. " found you! Run, hide, or stand up.", "warn")
end

local function updateRunning(bully, model: Model)
	for userId, encounter in encounters do
		if encounter.bully.id == bully.id and encounter.running then
			local player = Players:GetPlayerByUserId(userId)
			local profile = player and DataService.get(player)
			if not player or not profile then
				encounters[userId] = nil
				continue
			end
			local root = playerRoot(player)
			local distance = if root then (root.Position - model:GetPivot().Position).Magnitude else 0
			if distance >= 45 then
				Progress.applySpeed(player)
				win(player, profile, bully, "You got away safely!", "escapes", 24)
			elseif os.clock() >= (encounter.runUntil or 0) then
				Progress.applySpeed(player)
				lose(player, profile, "The bully kept up with you. Try hiding or buy the sneakers.")
			end
		end
	end
end

local function step(bully, model: Model, dt: number)
	updateRunning(bully, model)

	local origin = model:GetPivot().Position
	if calmUntil[bully.id] and os.clock() < calmUntil[bully.id] then
		return
	end

	local target: Player? = nil
	local best = math.huge
	for _, player in Players:GetPlayers() do
		local profile = DataService.get(player)
		local root = playerRoot(player)
		if profile and root and profile.story >= bully.unlock then
			local encounter = encounters[player.UserId]
			if not encounter or (encounter.bully.id == bully.id and encounter.running) then
				local distance = (root.Position - origin).Magnitude
				if distance < bully.sight and distance < best then
					target = player
					best = distance
				end
			end
		end
	end

	if target then
		local root = playerRoot(target)
		if root then
			ActorFactory.moveTowards(model, root.Position, bully.speed, dt)
			if best <= bully.catch and not encounters[target.UserId] then
				startEncounter(target, bully)
			elseif best < bully.sight then
				Remotes.get("BullyWarning"):FireClient(target, { name = bully.name, distance = best })
			end
		end
		return
	end

	local spot = wanderTarget[bully.id]
	if not spot or (origin - spot).Magnitude < 3 then
		spot = bully.home + Vector3.new(math.random(-bully.range, bully.range), 0, math.random(-bully.range, bully.range))
		wanderTarget[bully.id] = spot
	end
	ActorFactory.moveTowards(model, spot, bully.speed * 0.55, dt)
end

function BullyService.start()
	local campus = workspace:FindFirstChild("SchoolCampus") or workspace

	for _, bully in Config.Bullies do
		models[bully.id] = ActorFactory.create({
			name = bully.name,
			role = bully.role,
			color = bully.color,
			position = bully.home,
			labelColor = Color3.fromRGB(255, 170, 170),
			parent = campus,
		})
	end

	Remotes.get("EncounterAction").OnServerEvent:Connect(function(player, action, itemId)
		if typeof(action) ~= "string" then
			return
		end
		if itemId ~= nil and typeof(itemId) ~= "string" then
			return
		end
		BullyService.act(player, action, itemId)
	end)

	Players.PlayerRemoving:Connect(function(player)
		encounters[player.UserId] = nil
	end)

	RunService.Heartbeat:Connect(function(dt)
		for _, bully in Config.Bullies do
			local model = models[bully.id]
			if model and model.Parent then
				local ok, err = pcall(step, bully, model, dt)
				if not ok then
					warn("[BraveKid] bully error:", err)
				end
			end
		end
	end)
end

return BullyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local DataService = {}

local STORE_NAME = "BraveKid_v1"
local profiles: { [number]: any } = {}
local store

local function getStore()
	if store ~= nil then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	store = if ok then result else false
	return store
end

local function newProfile()
	return {
		coins = Config.Start.coins,
		energy = Config.Start.energy,
		maxEnergy = Config.Start.maxEnergy,
		courage = Config.Start.courage,
		maxCourage = Config.Start.maxCourage,
		xp = Config.Start.xp,
		level = Config.Start.level,
		title = Config.Start.title,
		story = 0,
		storyClasses = 0,
		bag = {},
		gear = {},
		grades = Util.copy(Config.StartGrades),
		stats = {
			classes = 0,
			lunches = 0,
			escapes = 0,
			standups = 0,
			friendsHelped = 0,
			story = 0,
		},
		tasks = {},
		lastLunch = "",
		lastLocker = 0,
	}
end

local function repair(profile)
	local blank = newProfile()
	for key, value in blank do
		if profile[key] == nil then
			profile[key] = Util.copy(value)
		end
	end
	for key, value in blank.stats do
		if profile.stats[key] == nil then
			profile.stats[key] = value
		end
	end
	for key, value in blank.grades do
		if typeof(profile.grades[key]) ~= "number" then
			profile.grades[key] = value
		end
	end
	for _, task in Config.Tasks do
		if profile.tasks[task.id] == nil then
			profile.tasks[task.id] = { progress = 0, claimed = false }
		end
	end
	profile.stats.story = profile.story
	profile.title = Util.titleForLevel(profile.level, Config.Titles)
end

function DataService.leaderstats(player: Player, profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end

	local function set(name: string, value: number)
		local entry = folder:FindFirstChild(name)
		if not entry then
			entry = Instance.new("IntValue")
			entry.Name = name
			entry.Parent = folder
		end
		entry.Value = math.floor(value + 0.5)
	end

	set("Level", profile.level)
	set("Courage", profile.courage)
	set("Coins", profile.coins)
end

function DataService.toClient(profile)
	return {
		coins = profile.coins,
		energy = profile.energy,
		maxEnergy = profile.maxEnergy,
		courage = profile.courage,
		maxCourage = profile.maxCourage,
		xp = profile.xp,
		xpNeeded = Util.xpForLevel(profile.level),
		level = profile.level,
		title = profile.title,
		story = profile.story,
		bag = Util.copy(profile.bag),
		gear = Util.copy(profile.gear),
		grades = Util.copy(profile.grades),
		gpa = Util.round(Util.average(profile.grades), 0),
		stats = Util.copy(profile.stats),
		tasks = Util.copy(profile.tasks),
		power = Util.standUpPower(profile),
	}
end

function DataService.load(player: Player)
	local profile = newProfile()
	local dataStore = getStore()
	if dataStore then
		local ok, saved = pcall(function()
			return dataStore:GetAsync("p_" .. player.UserId)
		end)
		if ok and typeof(saved) == "table" then
			for key, value in saved do
				profile[key] = value
			end
		end
	end
	repair(profile)
	profiles[player.UserId] = profile
	DataService.leaderstats(player, profile)
	return profile
end

function DataService.get(player: Player)
	return profiles[player.UserId]
end

function DataService.save(player: Player)
	local profile = profiles[player.UserId]
	local dataStore = getStore()
	if not profile or not dataStore then
		return
	end
	pcall(function()
		dataStore:SetAsync("p_" .. player.UserId, profile)
	end)
end

function DataService.bind()
	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player)
		profiles[player.UserId] = nil
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			DataService.save(player)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local DataService = require(script.Parent.DataService)
local Progress = require(script.Parent.Progress)
local ScheduleService = require(script.Parent.ScheduleService)
local StoryService = require(script.Parent.StoryService)

local GameService = {}

local CHAT = {
	["Mr. Park"] = "Go to class when the bell rings. Levels make you braver.",
	["Mia"] = "Hide behind the lockers or the green bushes to avoid bullies.",
	["Sky"] = "Thanks for looking out for me.",
	["Shop Keeper"] = "The sneakers and the whistle are my best sellers.",
	["Principal"] = "A student who protects friends makes this school proud.",
}

function GameService.attendClass(player: Player, subject: string, room: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local period = ScheduleService.snapshot()
	if period.kind ~= "class" then
		Progress.notify(player, "There is no class right now. Check the timer at the top.", "warn")
		return
	end
	if period.subject ~= subject and period.room ~= room then
		Progress.notify(player, "Right now it is " .. period.name .. ". Go there instead.", "warn")
		return
	end
	if ScheduleService.didAttend(player.UserId) then
		Progress.notify(player, "You already joined this class.", "info")
		return
	end
	if profile.energy < Config.Class.energyCost then
		Progress.notify(player, "Too tired. Eat lunch or use a candy bar.", "warn")
		return
	end

	profile.energy -= Config.Class.energyCost
	profile.coins += Config.Class.coins
	profile.courage = Util.clamp(profile.courage + Config.Class.courage, 0, profile.maxCourage)
	if profile.grades[subject] then
		profile.grades[subject] = Util.clamp(profile.grades[subject] + Config.Class.gradeGain, 0, 100)
	end
	ScheduleService.markAttended(player.UserId)
	Progress.stat(profile, "classes")
	Progress.addXp(player, profile, Config.Class.xp)
	Progress.notify(player, (Config.SubjectNames[subject] or "Class") .. " done! You earned XP and coins.", "good")
	StoryService.onClass(player)
	Progress.push(player)
end

function GameService.lunch(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local period = ScheduleService.snapshot()
	if period.kind ~= "lunch" then
		Progress.notify(player, "The cafeteria serves food at lunch time.", "warn")
		return
	end
	local key = period.id .. tostring(period.day)
	if profile.lastLunch == key then
		Progress.notify(player, "You already ate lunch today.", "info")
		return
	end
	profile.lastLunch = key
	profile.energy = Util.clamp(profile.energy + Config.Lunch.energy, 0, profile.maxEnergy)
	profile.courage = Util.clamp(profile.courage + Config.Lunch.courage, 0, profile.maxCourage)
	Progress.stat(profile, "lunches")
	Progress.addXp(player, profile, Config.Lunch.xp)
	Progress.notify(player, "Lunch was good. Energy and courage restored.", "good")
	Progress.push(player)
end

function GameService.play(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local period = ScheduleService.snapshot()
	if period.kind == "class" and period.subject == "gym" then
		GameService.attendClass(player, "gym", "Playground")
		return
	end
	if profile.energy < Config.Playtime.energyCost then
		Progress.notify(player, "Too tired to play. Get some food first.", "warn")
		return
	end
	profile.energy -= Config.Playtime.energyCost
	profile.courage = Util.clamp(profile.courage + Config.Playtime.courage, 0, profile.maxCourage)
	Progress.addXp(player, profile, Config.Playtime.xp)
	Progress.notify(player, "You played outside and felt braver.", "good")
	Progress.push(player)
end

function GameService.talk(player: Player, npcName: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if StoryService.onTalk(player, npcName) then
		return
	end
	Progress.notify(player, npcName .. ": " .. (CHAT[npcName] or "Have a good day!"), "info")
end

function GameService.study(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if profile.energy < 10 then
		Progress.notify(player, "Too tired to study.", "warn")
		return
	end
	profile.energy -= 10
	for _, subject in Config.Subjects do
		profile.grades[subject] = Util.clamp(profile.grades[subject] + 0.6, 0, 100)
	end
	Progress.addXp(player, profile, 12)
	Progress.notify(player, "You studied in the library.", "good")
	Progress.push(player)
end

function GameService.rest(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	profile.energy = Util.clamp(profile.energy + 25, 0, profile.maxEnergy)
	profile.courage = Util.clamp(profile.courage + 25, 0, profile.maxCourage)
	Progress.notify(player, "You rested in the nurse office.", "good")
	Progress.push(player)
end

function GameService.locker(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if os.clock() - (profile.lastLocker or 0) < 12 then
		Progress.notify(player, "Nothing else in the locker right now.", "info")
		return
	end
	profile.lastLocker = os.clock()
	profile.energy = Util.clamp(profile.energy + 8, 0, profile.maxEnergy)
	Progress.notify(player, "You grabbed your things. You can hide behind lockers too.", "good")
	Progress.push(player)
end

function GameService.pickup(player: Player, itemId: string)
	local profile = DataService.get(player)
	if not profile or not Config.Items[itemId] then
		return
	end
	Progress.give(player, profile, itemId)
	Progress.push(player)
end

function GameService.buy(player: Player, itemId: string)
	local profile = DataService.get(player)
	local item = Config.Items[itemId]
	if not profile or not item or item.price <= 0 then
		return
	end
	if item.kind == "gear" and profile.gear[itemId] then
		Progress.notify(player, "You already own that.", "info")
		return
	end
	if profile.coins < item.price then
		Progress.notify(player, "Not enough coins. Go to class to earn more.", "warn")
		return
	end
	profile.coins -= item.price
	Progress.give(player, profile, itemId)
	if item.kind == "gear" then
		Progress.applySpeed(player)
	end
	StoryService.onBuy(player, itemId)
	Progress.push(player)
end

function GameService.useItem(player: Player, itemId: string)
	local profile = DataService.get(player)
	local item = Config.Items[itemId]
	if not profile or not item then
		return
	end
	if item.kind == "gear" then
		Progress.notify(player, "Gear works automatically while you own it.", "info")
		return
	end
	if (profile.bag[itemId] or 0) < 1 then
		Progress.notify(player, "That item is not in your bag.", "warn")
		return
	end
	if item.kind == "encounter" then
		Progress.notify(player, "Save that for when a bully catches you.", "info")
		return
	end
	profile.bag[itemId] -= 1
	profile.energy = Util.clamp(profile.energy + (item.energy or 0), 0, profile.maxEnergy)
	profile.courage = Util.clamp(profile.courage + (item.courage or 0), 0, profile.maxCourage)
	if item.grades then
		for _, subject in Config.Subjects do
			profile.grades[subject] = Util.clamp(profile.grades[subject] + item.grades, 0, 100)
		end
	end
	if item.xp then
		Progress.addXp(player, profile, item.xp)
	end
	Progress.notify(player, "You used " .. item.name .. ".", "good")
	Progress.push(player)
end

function GameService.claimTask(player: Player, taskId: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local task
	for _, entry in Config.Tasks do
		if entry.id == taskId then
			task = entry
			break
		end
	end
	local state = profile.tasks[taskId]
	if not task or not state or state.claimed then
		return
	end
	if (state.progress or 0) < task.goal then
		Progress.notify(player, "That task is not finished yet.", "warn")
		return
	end
	state.claimed = true
	profile.coins += task.coins
	Progress.addXp(player, profile, task.xp)
	Progress.notify(player, "Task complete: " .. task.name, "good")
	Progress.push(player)
end

function GameService.missedClass(period, attendedMap)
	if period.kind ~= "class" then
		return
	end
	for _, player in Players:GetPlayers() do
		local profile = DataService.get(player)
		if profile and not attendedMap[player.UserId] then
			if period.subject and profile.grades[period.subject] then
				profile.grades[period.subject] =
					Util.clamp(profile.grades[period.subject] - Config.Class.missPenalty, 0, 100)
			end
			Progress.notify(player, "You missed " .. period.name .. ". Class is the easiest way to level up.", "warn")
			Progress.push(player)
		end
	end
end

local function handle(player: Player, source: Instance)
	local action = source:GetAttribute("Action")
	if action == "Class" then
		GameService.attendClass(player, source:GetAttribute("Subject"), source:GetAttribute("Room"))
	elseif action == "Lunch" then
		GameService.lunch(player)
	elseif action == "Play" then
		GameService.play(player)
	elseif action == "Talk" then
		GameService.talk(player, source:GetAttribute("Npc") or "Friend")
	elseif action == "Study" then
		GameService.study(player)
	elseif action == "Rest" then
		GameService.rest(player)
	elseif action == "Locker" then
		GameService.locker(player)
	elseif action == "Shop" then
		Remotes.get("OpenShop"):FireClient(player)
	elseif action == "Pickup" then
		local itemId = source:GetAttribute("Item")
		if typeof(itemId) == "string" then
			GameService.pickup(player, itemId)
			source:Destroy()
		end
	end
end

function GameService.bind()
	ScheduleService.onPeriodEnd(GameService.missedClass)

	local function connect(instance: Instance)
		local prompt = instance:FindFirstChildOfClass("ProximityPrompt")
		if not prompt then
			return
		end
		prompt.Triggered:Connect(function(player)
			local ok, err = pcall(handle, player, instance)
			if not ok then
				warn("[BraveKid] interaction error:", err)
			end
		end)
	end

	for _, instance in CollectionService:GetTagged("Interact") do
		connect(instance)
	end
	CollectionService:GetInstanceAddedSignal("Interact"):Connect(connect)

	Remotes.get("GetProfile").OnServerEvent:Connect(function(player)
		if DataService.get(player) then
			Progress.push(player)
			Remotes.get("PeriodChanged"):FireClient(player, ScheduleService.snapshot())
		end
	end)
	Remotes.get("BuyItem").OnServerEvent:Connect(function(player, itemId)
		if typeof(itemId) == "string" then
			GameService.buy(player, itemId)
		end
	end)
	Remotes.get("UseItem").OnServerEvent:Connect(function(player, itemId)
		if typeof(itemId) == "string" then
			GameService.useItem(player, itemId)
		end
	end)
	Remotes.get("ClaimTask").OnServerEvent:Connect(function(player, taskId)
		if typeof(taskId) == "string" then
			GameService.claimTask(player, taskId)
		end
	end)
end

return GameService
]]></string>
        </Properties>
