  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BullyService</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local CharacterFactory = require(script.Parent.CharacterFactory)
local DataService = require(script.Parent.DataService)
local Progress = require(script.Parent.Progress)
local StoryService = require(script.Parent.StoryService)

local BullyService = {}

local models: { [string]: Model } = {}
local stunnedUntil: { [string]: number } = {}
local encounters: { [number]: any } = {}
local runningAway: { [number]: boolean } = {}

local NURSE_CF = CFrame.new(-42, 6, 62)

local function rootPart(model: Model): BasePart?
	return model.PrimaryPart
end

local function playerRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function nearHide(player: Player): boolean
	local root = playerRoot(player)
	if not root then
		return false
	end
	for _, spot in CollectionService:GetTagged("HideSpot") do
		if spot:IsA("BasePart") and (spot.Position - root.Position).Magnitude <= 10 then
			return true
		end
	end
	return false
end

local function sendToNurse(player: Player)
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		character.HumanoidRootPart.CFrame = NURSE_CF
	end
	Progress.notify(player, "보건실로 이동했어요. 잠시 쉬며 용기를 회복합니다.", "warn")
end

local function endEncounter(player: Player)
	encounters[player.UserId] = nil
	runningAway[player.UserId] = nil
	Remotes.get("EncounterEnd"):FireClient(player)
end

function BullyService.resolve(player: Player, action: string, itemId: string?)
	local encounter = encounters[player.UserId]
	if not encounter then
		return
	end
	local profile = DataService.get(player)
	local bully = encounter.info
	if not profile then
		return
	end

	local model = models[bully.id]
	local bullyRoot = model and rootPart(model)

	if action == "item" then
		local item = itemId and Config.Items[itemId]
		local count = itemId and (profile.inventory[itemId] or 0) or 0
		if not item or count < 1 then
			Progress.notify(player, "쓸 수 있는 아이템이 없어요.", "warn")
			return
		end
		profile.inventory[itemId] -= 1
		if item.escape then
			Progress.bump(profile, "bulliesDodged")
			Progress.addXp(player, profile, 18)
			Progress.notify(player, "친구의 쪽지로 빠져나왔어요!", "good")
			StoryService.onBullyResolved(player, bully.id)
			endEncounter(player)
			Progress.push(player)
			return
		end
		if item.scare then
			action = "fight"
			encounter.bonus = item.powerBonus or 5
			Progress.notify(player, "호루라기를 불었어요! 맞서기 힘이 올라갑니다.", "info")
		elseif item.courage or item.energy then
			profile.courage = Util.clamp(profile.courage + (item.courage or 0), 0, profile.maxCourage)
			profile.energy = Util.clamp(profile.energy + (item.energy or 0), 0, profile.maxEnergy)
			Progress.notify(player, item.name .. " 을(를) 썼어요. 다시 선택하세요!", "info")
			Progress.push(player)
			return
		end
	end

	if action == "hide" then
		if nearHide(player) then
			Progress.bump(profile, "bulliesDodged")
			Progress.addXp(player, profile, 22)
			Progress.notify(player, "숨어서 왕딱... 아니, 불리를 피했어요!", "good")
			StoryService.onBullyResolved(player, bully.id)
			endEncounter(player)
			Progress.push(player)
			return
		end
		Progress.notify(player, "근처에 숨을 곳이 없어요. 사물함이나 덤불 뒤로 가세요!", "warn")
		return
	end

	if action == "run" then
		if runningAway[player.UserId] then
			return
		end
		runningAway[player.UserId] = true
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 28
		end
		Progress.notify(player, "도망치세요! 멀리 떨어지면 성공입니다.", "info")
		task.delay(6.5, function()
			if not encounters[player.UserId] then
				Progress.applySpeed(player)
				return
			end
			local still = playerRoot(player)
			local other = bullyRoot
			local far = still and other and (still.Position - other.Position).Magnitude or 0
			Progress.applySpeed(player)
			if far >= 28 then
				Progress.bump(profile, "bulliesDodged")
				Progress.addXp(player, profile, 26)
				Progress.notify(player, "멀리 도망쳐서 피했어요!", "good")
				StoryService.onBullyResolved(player, bully.id)
			else
				profile.courage = Util.clamp(profile.courage - 18, 0, profile.maxCourage)
				Progress.notify(player, "따라잡혀서 용기가 떨어졌어요. 보건실로 가요.", "warn")
				sendToNurse(player)
				profile.courage = Util.clamp(profile.courage + 25, 0, profile.maxCourage)
			end
			endEncounter(player)
			Progress.push(player)
		end)
		return
	end

	if action == "fight" then
		local power = Util.confrontPower(profile, Config) + (encounter.bonus or 0)
		if power >= bully.power then
			stunnedUntil[bully.id] = os.clock() + 22
			Progress.bump(profile, "bulliesDefeated")
			Progress.addXp(player, profile, bully.xp)
			profile.coins += bully.coins
			profile.courage = Util.clamp(profile.courage + 8, 0, profile.maxCourage)
			Progress.notify(player, string.format("%s 에게 맞서서 이겼어요! (힘 %d vs %d)", bully.name, power, bully.power), "good")
			StoryService.onBullyResolved(player, bully.id)
		else
			profile.courage = Util.clamp(profile.courage - 22, 0, profile.maxCourage)
			Progress.notify(
				player,
				string.format("아직 힘이 부족해요. (내 힘 %d / 상대 %d) 수업과 아이템으로 더 강해지세요.", power, bully.power),
				"warn"
			)
			sendToNurse(player)
			profile.courage = Util.clamp(profile.courage + 20, 0, profile.maxCourage)
		end
		endEncounter(player)
		Progress.push(player)
	end
end

local function tryEncounter(player: Player, info)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if profile.storyStep < info.storyMin then
		return
	end
	if encounters[player.UserId] then
		return
	end
	if stunnedUntil[info.id] and os.clock() < stunnedUntil[info.id] then
		return
	end
	encounters[player.UserId] = { info = info }
	Remotes.get("EncounterStart"):FireClient(player, {
		id = info.id,
		name = info.name,
		title = info.title,
		power = info.power,
		playerPower = Util.confrontPower(profile, Config),
		boss = info.boss == true,
	})
	Progress.notify(player, string.format("%s 가 다가온다! 피하거나 맞서세요.", info.name), "warn")
end

local function tickBully(info, model: Model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = rootPart(model)
	if not humanoid or not root then
		return
	end

	if stunnedUntil[info.id] and os.clock() < stunnedUntil[info.id] then
		return
	end

	local targetPlayer = nil
	local targetDist = math.huge
	for _, player in Players:GetPlayers() do
		local profile = DataService.get(player)
		local pr = playerRoot(player)
		if profile and pr and profile.storyStep >= info.storyMin and not encounters[player.UserId] then
			local dist = (pr.Position - root.Position).Magnitude
			if dist < info.detect and dist < targetDist then
				targetPlayer = player
				targetDist = dist
			end
		end
	end

	if targetPlayer then
		Remotes.get("BullyWarning"):FireClient(targetPlayer, { name = info.name, distance = targetDist })
		if targetDist <= info.catch then
			tryEncounter(targetPlayer, info)
		else
			humanoid:MoveTo(playerRoot(targetPlayer).Position)
		end
	else
		local wander = info.start + Vector3.new(math.random(-18, 18), 0, math.random(-18, 18))
		humanoid:MoveTo(wander)
	end
end

function BullyService.start()
	for _, info in Config.Bullies do
		local model = CharacterFactory.create({
			name = info.name,
			title = info.title,
			color = info.color,
			start = info.start,
			walkSpeed = 13,
			labelColor = Color3.fromRGB(255, 170, 170),
			attributes = { BullyId = info.id },
		})
		models[info.id] = model
	end

	Remotes.get("EncounterAction").OnServerEvent:Connect(function(player, action, itemId)
		if typeof(action) ~= "string" then
			return
		end
		if itemId ~= nil and typeof(itemId) ~= "string" then
			return
		end
		BullyService.resolve(player, action, itemId)
	end)

	task.spawn(function()
		while true do
			task.wait(0.35)
			for _, info in Config.Bullies do
				local model = models[info.id]
				if model and model.Parent then
					pcall(tickBully, info, model)
				end
			end
		end
	end)
end

return BullyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">CharacterFactory</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")

local CharacterFactory = {}

local function limb(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, collide: boolean)
	local piece = Instance.new("Part")
	piece.Name = name
	piece.Size = size
	piece.CFrame = cframe
	piece.Color = color
	piece.Material = Enum.Material.SmoothPlastic
	piece.Anchored = false
	piece.CanCollide = collide
	piece.Parent = parent
	return piece
end

local function weld(root: BasePart, other: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = other
	w.Parent = root
end

function CharacterFactory.create(info): Model
	local model = Instance.new("Model")
	model.Name = info.name

	local start = info.start
	local color = info.color
	local root = limb(model, "HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(start), color, true)
	root.Transparency = 1
	local torso = limb(model, "Torso", Vector3.new(2, 2, 1), CFrame.new(start), color, true)
	local head = limb(model, "Head", Vector3.new(1.5, 1.5, 1.5), CFrame.new(start + Vector3.new(0, 1.8, 0)), Color3.fromRGB(232, 198, 164), false)
	local leftArm = limb(model, "Left Arm", Vector3.new(1, 2, 1), CFrame.new(start + Vector3.new(-1.5, 0, 0)), color, false)
	local rightArm = limb(model, "Right Arm", Vector3.new(1, 2, 1), CFrame.new(start + Vector3.new(1.5, 0, 0)), color, false)
	local pants = Color3.fromRGB(48, 52, 72)
	local leftLeg = limb(model, "Left Leg", Vector3.new(1, 2, 1), CFrame.new(start + Vector3.new(-0.5, -2, 0)), pants, false)
	local rightLeg = limb(model, "Right Leg", Vector3.new(1, 2, 1), CFrame.new(start + Vector3.new(0.5, -2, 0)), pants, false)

	weld(root, torso)
	weld(root, head)
	weld(root, leftArm)
	weld(root, rightArm)
	weld(root, leftLeg)
	weld(root, rightLeg)

	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayName = info.name
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.WalkSpeed = info.walkSpeed or 11
	humanoid.Parent = model
	model.PrimaryPart = root

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 44)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.AlwaysOnTop = true
	gui.Parent = head

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.Text = info.name .. "\n" .. (info.title or "")
	label.TextColor3 = info.labelColor or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.25
	label.TextScaled = true
	label.Parent = gui

	if info.interact then
		CollectionService:AddTag(root, "SchoolInteract")
		root:SetAttribute("Interact", info.interact)
		root:SetAttribute("NpcName", info.name)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = info.actionText or "대화하기"
		prompt.ObjectText = info.name
		prompt.HoldDuration = 0.15
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = root
	end

	for key, value in info.attributes or {} do
		root:SetAttribute(key, value)
		model:SetAttribute(key, value)
	end

	model.Parent = workspace:FindFirstChild("SchoolCampus") or workspace
	return model
end

return CharacterFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local DataService = {}

local STORE_NAME = "SchoolStory_v1"
local profiles: { [number]: any } = {}
local store

local function getStore()
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	return store
end

local function blankProfile()
	return {
		coins = Config.Starting.coins,
		energy = Config.Starting.energy,
		maxEnergy = Config.Starting.maxEnergy,
		courage = Config.Starting.courage,
		maxCourage = Config.Starting.maxCourage,
		popularity = Config.Starting.popularity,
		xp = Config.Starting.xp,
		level = Config.Starting.level,
		title = Config.Starting.title,
		storyStep = 0,
		classesThisStory = 0,
		inventory = {},
		owned = {},
		grades = Util.deepCopy(Config.StartingGrades),
		stats = {
			classesAttended = 0,
			lunchesEaten = 0,
			talks = 0,
			plays = 0,
			skipped = 0,
			bulliesDodged = 0,
			bulliesDefeated = 0,
			friendsHelped = 0,
			storyStep = 0,
		},
		quests = {},
		lastLunchPeriod = "",
		lastTalkAt = 0,
		lastLockerAt = 0,
	}
end

local function ensureShape(profile)
	local blank = blankProfile()
	for key, value in blank do
		if profile[key] == nil then
			profile[key] = Util.deepCopy(value)
		end
	end
	for key, value in blank.stats do
		if profile.stats[key] == nil then
			profile.stats[key] = value
		end
	end
	for _, quest in Config.Quests do
		if not profile.quests[quest.id] then
			profile.quests[quest.id] = { progress = 0, claimed = false }
		end
	end
	profile.stats.storyStep = profile.storyStep
	profile.title = Util.titleForLevel(profile.level, Config.LevelTitles)
end

function DataService.createLeaderstats(player: Player, profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end

	local function stat(name: string, value: number)
		local int = folder:FindFirstChild(name)
		if not int then
			int = Instance.new("IntValue")
			int.Name = name
			int.Parent = folder
		end
		int.Value = math.floor(value + 0.5)
	end

	stat("레벨", profile.level)
	stat("용기", profile.courage)
	stat("코인", profile.coins)
end

function DataService.publicProfile(profile)
	return {
		coins = profile.coins,
		energy = profile.energy,
		maxEnergy = profile.maxEnergy,
		courage = profile.courage,
		maxCourage = profile.maxCourage,
		popularity = profile.popularity,
		xp = profile.xp,
		xpNeeded = Util.xpForLevel(profile.level),
		level = profile.level,
		title = profile.title,
		storyStep = profile.storyStep,
		inventory = Util.deepCopy(profile.inventory),
		owned = Util.deepCopy(profile.owned),
		grades = Util.deepCopy(profile.grades),
		gpa = Util.round(Util.average(profile.grades), 1),
		stats = Util.deepCopy(profile.stats),
		quests = Util.deepCopy(profile.quests),
		power = Util.confrontPower(profile, Config),
	}
end

function DataService.load(player: Player)
	local profile = blankProfile()
	local dataStore = getStore()
	if dataStore then
		local ok, saved = pcall(function()
			return dataStore:GetAsync("p_" .. player.UserId)
		end)
		if ok and typeof(saved) == "table" then
			for key, value in saved do
				profile[key] = value
			end
		end
	end
	ensureShape(profile)
	profiles[player.UserId] = profile
	DataService.createLeaderstats(player, profile)
	return profile
end

function DataService.get(player: Player)
	return profiles[player.UserId]
end

function DataService.save(player: Player)
	local profile = profiles[player.UserId]
	local dataStore = getStore()
	if not profile or not dataStore then
		return
	end
	pcall(function()
		dataStore:SetAsync("p_" .. player.UserId, profile)
	end)
end

function DataService.release(player: Player)
	DataService.save(player)
	profiles[player.UserId] = nil
end

function DataService.bind()
	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			DataService.save(player)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">GameService</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local DataService = require(script.Parent.DataService)
local Progress = require(script.Parent.Progress)
local ScheduleService = require(script.Parent.ScheduleService)
local StoryService = require(script.Parent.StoryService)

local GameService = {}

local FLAVOR = {
	김선생님 = "수업 종이 울리면 교실로 가렴. 레벨이 오르면 불리에게 맞설 수 있어.",
	민지 = "사물함 뒤에 숨으면 복도 불리를 피할 수 있어!",
	하늘 = "운동장 쪽이 아직 무서워. 네가 있어 줘서 고마워.",
	교장선생님 = "친구를 지키는 학생이 우리 학교의 자랑이지.",
	매점아저씨 = "운동화랑 호루라기가 잘 나가. 불리 대비에 좋지.",
}

function GameService.attendClass(player: Player, subject: string, roomId: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local period = ScheduleService.snapshot()
	if period.kind ~= "class" then
		Progress.notify(player, "지금은 수업 시간이 아니에요.", "warn")
		return
	end
	if period.room ~= roomId and period.subject ~= subject then
		Progress.notify(player, string.format("지금은 %s 이에요. 그곳으로 가세요.", period.name), "warn")
		return
	end
	if ScheduleService.didAttend(player.UserId) then
		Progress.notify(player, "이번 교시 수업은 이미 들었어요.", "info")
		return
	end
	if profile.energy < Config.Class.energyCost then
		Progress.notify(player, "에너지가 부족해요. 급식이나 초콜릿을 챙기세요.", "warn")
		return
	end

	profile.energy -= Config.Class.energyCost
	profile.coins += Config.Class.coinReward
	profile.courage = Util.clamp(profile.courage + Config.Class.courageGain, 0, profile.maxCourage)
	if profile.grades[subject] then
		profile.grades[subject] = Util.clamp(profile.grades[subject] + Config.Class.gradeGain, 0, 100)
	end
	Progress.addXp(player, profile, Config.Class.xpReward)
	ScheduleService.markAttended(player.UserId)
	Progress.bump(profile, "classesAttended")
	Progress.notify(player, string.format("%s 수업 완료! 경험치와 용기가 올랐어요.", Config.SubjectNames[subject] or subject), "good")
	StoryService.onClass(player)
	Progress.push(player)
end

function GameService.eatLunch(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local period = ScheduleService.snapshot()
	if period.kind ~= "lunch" then
		Progress.notify(player, "급식은 점심시간에만 먹을 수 있어요.", "warn")
		return
	end
	if profile.lastLunchPeriod == period.id .. period.day then
		Progress.notify(player, "이번 점심은 이미 먹었어요.", "info")
		return
	end
	profile.lastLunchPeriod = period.id .. period.day
	profile.energy = Util.clamp(profile.energy + Config.Lunch.energyRestore, 0, profile.maxEnergy)
	profile.courage = Util.clamp(profile.courage + Config.Lunch.courageRestore, 0, profile.maxCourage)
	Progress.addXp(player, profile, 10)
	Progress.bump(profile, "lunchesEaten")
	Progress.notify(player, "급식을 먹었어요. 에너지와 용기가 회복됐습니다.", "good")
	Progress.push(player)
end

function GameService.play(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local period = ScheduleService.snapshot()
	if period.kind == "class" and period.subject == "pe" then
		GameService.attendClass(player, "pe", "Playground")
		return
	end
	if profile.energy < Config.Play.energyCost then
		Progress.notify(player, "놀기엔 에너지가 부족해요.", "warn")
		return
	end
	profile.energy -= Config.Play.energyCost
	profile.courage = Util.clamp(profile.courage + Config.Play.courageGain, 0, profile.maxCourage)
	Progress.addXp(player, profile, Config.Play.xpReward)
	Progress.bump(profile, "plays")
	Progress.notify(player, "운동장에서 몸을 풀었어요.", "good")
	Progress.push(player)
end

function GameService.talk(player: Player, npcName: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local now = os.clock()
	if StoryService.onTalk(player, npcName) then
		Progress.bump(profile, "talks")
		return
	end
	if now - (profile.lastTalkAt or 0) < 8 then
		Progress.notify(player, "조금 뒤에 다시 이야기해 보세요.", "info")
		return
	end
	profile.lastTalkAt = now
	Progress.bump(profile, "talks")
	Progress.addXp(player, profile, 4)
	Progress.notify(player, string.format("%s: %s", npcName, FLAVOR[npcName] or "오늘도 힘내!"), "info")
	Progress.push(player)
end

function GameService.study(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if profile.energy < 10 then
		Progress.notify(player, "자습하기엔 너무 피곤해요.", "warn")
		return
	end
	profile.energy -= 10
	for _, key in Config.GradeKeys do
		profile.grades[key] = Util.clamp(profile.grades[key] + 0.5, 0, 100)
	end
	Progress.addXp(player, profile, 12)
	Progress.notify(player, "도서관에서 자습했어요.", "good")
	Progress.push(player)
end

function GameService.locker(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	if os.clock() - (profile.lastLockerAt or 0) < 12 then
		Progress.notify(player, "사물함은 잠시 뒤에 다시 열 수 있어요.", "info")
		return
	end
	profile.lastLockerAt = os.clock()
	profile.energy = Util.clamp(profile.energy + 8, 0, profile.maxEnergy)
	Progress.notify(player, "사물함에서 준비물을 챙겼어요. 뒤에 숨으면 불리를 피할 수 있어요.", "good")
	Progress.push(player)
end

function GameService.pickup(player: Player, itemId: string)
	local profile = DataService.get(player)
	if not profile or not Config.Items[itemId] then
		return
	end
	Progress.giveItem(player, profile, itemId, 1)
	Progress.push(player)
end

function GameService.buy(player: Player, itemId: string)
	local profile = DataService.get(player)
	local item = Config.Items[itemId]
	if not profile or not item or item.price <= 0 then
		return
	end
	if item.kind == "equip" and profile.owned[itemId] then
		Progress.notify(player, "이미 가지고 있어요.", "info")
		return
	end
	if profile.coins < item.price then
		Progress.notify(player, "코인이 부족해요. 수업을 들으면 용돈을 받아요.", "warn")
		return
	end
	profile.coins -= item.price
	Progress.giveItem(player, profile, itemId, 1)
	if item.kind == "equip" then
		Progress.applySpeed(player)
	end
	StoryService.onBuy(player, itemId)
	StoryService.syncOwned(player)
	Progress.push(player)
end

function GameService.useItem(player: Player, itemId: string)
	local profile = DataService.get(player)
	local item = Config.Items[itemId]
	if not profile or not item then
		return
	end
	if item.kind == "equip" then
		Progress.notify(player, "장착 아이템은 가지고 있으면 자동으로 효과가 있어요.", "info")
		return
	end
	if (profile.inventory[itemId] or 0) < 1 then
		Progress.notify(player, "가방에 그 아이템이 없어요.", "warn")
		return
	end
	if item.escape or item.scare then
		Progress.notify(player, "이 아이템은 불리와 마주쳤을 때 쓰세요.", "info")
		return
	end
	profile.inventory[itemId] -= 1
	if item.energy then
		profile.energy = Util.clamp(profile.energy + item.energy, 0, profile.maxEnergy)
	end
	if item.courage then
		profile.courage = Util.clamp(profile.courage + item.courage, 0, profile.maxCourage)
	end
	if item.allGrades then
		for _, key in Config.GradeKeys do
			profile.grades[key] = Util.clamp(profile.grades[key] + item.allGrades, 0, 100)
		end
	end
	if item.xp then
		Progress.addXp(player, profile, item.xp)
	end
	Progress.notify(player, item.name .. " 을(를) 사용했어요.", "good")
	Progress.push(player)
end

function GameService.claimQuest(player: Player, questId: string)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local quest
	for _, entry in Config.Quests do
		if entry.id == questId then
			quest = entry
			break
		end
	end
	local state = profile.quests[questId]
	if not quest or not state or state.claimed then
		return
	end
	if (state.progress or 0) < quest.goal then
		Progress.notify(player, "아직 끝나지 않은 할 일이에요.", "warn")
		return
	end
	state.claimed = true
	profile.coins += quest.rewardCoins
	Progress.addXp(player, profile, quest.rewardXp)
	Progress.notify(player, "할 일 보상: " .. quest.name, "good")
	Progress.push(player)
end

function GameService.handleSkip(period, attendedMap)
	if period.kind ~= "class" then
		return
	end
	for _, player in Players:GetPlayers() do
		local profile = DataService.get(player)
		if profile and not attendedMap[player.UserId] then
			Progress.bump(profile, "skipped")
			if period.subject and profile.grades[period.subject] then
				profile.grades[period.subject] = Util.clamp(profile.grades[period.subject] - Config.Class.skipGradePenalty, 0, 100)
			end
			Progress.notify(player, period.name .. " 를 빠졌어요. 수업은 레벨 올리는 제일 쉬운 방법이에요.", "warn")
			Progress.push(player)
		end
	end
end

function GameService.bind()
	ScheduleService.onPeriodEnded(GameService.handleSkip)

	local function bindPrompt(instance: Instance)
		local prompt = instance:FindFirstChildOfClass("ProximityPrompt")
		if not prompt then
			return
		end
		prompt.Triggered:Connect(function(player)
			local interact = instance:GetAttribute("Interact")
			if interact == "AttendClass" then
				GameService.attendClass(player, instance:GetAttribute("Subject"), instance:GetAttribute("RoomId"))
			elseif interact == "EatLunch" then
				GameService.eatLunch(player)
			elseif interact == "Play" then
				GameService.play(player)
			elseif interact == "Talk" then
				GameService.talk(player, instance:GetAttribute("NpcName") or "친구")
			elseif interact == "Study" then
				GameService.study(player)
			elseif interact == "Locker" then
				GameService.locker(player)
			elseif interact == "Pickup" then
				local itemId = instance:GetAttribute("ItemId")
				if typeof(itemId) == "string" then
					GameService.pickup(player, itemId)
					instance:Destroy()
				end
			elseif interact == "OpenShop" then
				Remotes.get("Notify"):FireClient(player, { text = "SHOP_OPEN", tone = "shop" })
			end
		end)
	end

	for _, instance in CollectionService:GetTagged("SchoolInteract") do
		bindPrompt(instance)
	end
	CollectionService:GetInstanceAddedSignal("SchoolInteract"):Connect(bindPrompt)

	Remotes.get("GetProfile").OnServerEvent:Connect(function(player)
		if DataService.get(player) then
			Progress.push(player)
			Remotes.get("PeriodChanged"):FireClient(player, ScheduleService.snapshot())
		end
	end)
	Remotes.get("BuyItem").OnServerEvent:Connect(function(player, itemId)
		if typeof(itemId) == "string" then
			GameService.buy(player, itemId)
		end
	end)
	Remotes.get("UseItem").OnServerEvent:Connect(function(player, itemId)
		if typeof(itemId) == "string" then
			GameService.useItem(player, itemId)
		end
	end)
	Remotes.get("ClaimQuest").OnServerEvent:Connect(function(player, questId)
		if typeof(questId) == "string" then
			GameService.claimQuest(player, questId)
		end
	end)
end

return GameService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local SchoolBuilder = require(script.Parent.SchoolBuilder)
local DataService = require(script.Parent.DataService)
local Progress = require(script.Parent.Progress)
local ScheduleService = require(script.Parent.ScheduleService)
local GameService = require(script.Parent.GameService)
local NPCService = require(script.Parent.NPCService)
local BullyService = require(script.Parent.BullyService)
local StoryService = require(script.Parent.StoryService)

Remotes.ensure()
SchoolBuilder.build()
DataService.bind()
GameService.bind()
ScheduleService.start()
NPCService.start()
BullyService.start()

local function setupPlayer(player: Player)
	DataService.load(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.2)
		Progress.applySpeed(player)
	end)
	if player.Character then
		Progress.applySpeed(player)
	end
	StoryService.intro(player)
	Remotes.get("PeriodChanged"):FireClient(player, ScheduleService.snapshot())
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(setupPlayer, player)
end

print("[우리학교 대모험] 서버가 시작되었습니다.")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
